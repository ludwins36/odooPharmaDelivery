<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Tree -->
    <record id="prestashop_log_view_tree" model="ir.ui.view">
        <field name="name">prestashop.log.tree</field>
        <field name="model">prestashop.log</field>
        <field name="arch" type="xml">
            <tree decoration-danger="status == 'error'" decoration-warning="status == 'warning'" 
                  decoration-success="status == 'success'">
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="operation"/>
                <field name="model"/>
                <field name="status" widget="badge" 
                       decoration-danger="status == 'error'"
                       decoration-warning="status == 'warning'"
                       decoration-success="status == 'success'"/>
                <field name="message"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="prestashop_log_view_form" model="ir.ui.view">
        <field name="name">prestashop.log.form</field>
        <field name="model">prestashop.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_view_record" string="Ver Registro" type="object" 
                            class="btn-primary" invisible="not record_id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="user_id"/>
                            <field name="operation"/>
                        </group>
                        <group>
                            <field name="model"/>
                            <field name="record_id"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Search -->
    <record id="prestashop_log_view_search" model="ir.ui.view">
        <field name="name">prestashop.log.search</field>
        <field name="model">prestashop.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="message"/>
                <field name="model"/>
                <filter string="Éxito" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                <filter string="Advertencia" name="warning" domain="[('status', '=', 'warning')]"/>
                <separator/>
                <filter string="Hoy" name="today" domain="[('create_date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Usuario" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Operación" name="group_operation" context="{'group_by': 'operation'}"/>
                    <filter string="Modelo" name="group_model" context="{'group_by': 'model'}"/>
                    <filter string="Estado" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción -->
    <record id="prestashop_log_action" model="ir.actions.act_window">
        <field name="name">Logs de Sincronización</field>
        <field name="res_model">prestashop.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>

</odoo>
